# Files shipped in the sdist. The CLI itself is inside the crisis_rehearsal
# package; everything else here is the evidence pack + the v0.1/v0.2 reproduction
# scripts that the CLI reuses (it imports them, it does not modify them).
include LICENSE
include README.md
include requirements.txt
include pyproject.toml
include MANIFEST.in
include Makefile
include Dockerfile
include docker-compose.yml
include .gitignore
include .gitattributes

# Scenario-pack schema: one copy inside the package (used by installed wheels),
# one at the repository root (the path we publish to integrators).
recursive-include crisis_rehearsal/schema *.json
recursive-include schema *.json

# Tests, docs and the shipped evidence pack.
recursive-include tests *.py
recursive-include docs *.md
recursive-include docs/assets *.txt *.svg *.png *.html
recursive-include data *.csv *.md *.jsonl *.sha256
recursive-include scripts *.py

global-exclude __pycache__
global-exclude *.py[cod]
global-exclude .DS_Store
